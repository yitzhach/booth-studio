{
  "name": "booth-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "bundle:scene": "vite build --config vite.scene.config.js --logLevel warn",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json; s=$?; tsc -p tsconfig.app.json || s=1; exit $s",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node tests/e2e.mjs",
    "test:offline": "node tests/offline.mjs",
    "test:view": "node tests/run-views.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jpeg-js": "^0.4.4",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "wrangler": "^4.0.0"
  }
}
