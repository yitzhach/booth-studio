// The page's own modules (ROADMAP.md 1.4, second half): everything in src/
// that tsconfig.json does not already check, against a browser's globals
// rather than a Worker's. `npm run typecheck` runs both. Since the typing
// pass (TYPING_PHASE.md) that is every module but the vendored files, and
// tests/typecheck-scope.test.js holds the exclude list there. The scene's
// mixins are put on BoothScene by src/scene/types.d.ts; the vendored SDK,
// generated in Art-Talk-Back, is typed by src/vendor/studio-sdk.d.ts beside
// it, which tests/studio-sdk-types.test.js holds to the module's exports.
// Same rules as tsconfig.json otherwise: JSDoc as the types, not strict.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    // import.meta.env (DEV, PROD) as Vite defines it; the page's check only.
    "types": ["vite/client"]
  },
  "files": [],
  "include": ["src/**/*.js", "src/globals.d.ts", "src/scene/types.d.ts"],
  "exclude": ["src/vendor/**"]
}
