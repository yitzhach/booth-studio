{
  "name": "booth-studio",
  "compatibility_date": "2026-09-13",
  // The one backend: booth share links (worker/index.js). Only /api/* reaches
  // it; every other path is the static app, as it was before.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "booth-studio-shares" }],
  // Per address, per minute: links made or updated, and images uploaded. An
  // honest sender makes one link and uploads its images one at a time.
  "ratelimits": [
    { "name": "LINK_RATE", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
    { "name": "IMAGE_RATE", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
  ],
  // The daily sweep of lapsed links (`scheduled` in worker/index.js).
  "triggers": { "crons": ["17 4 * * *"] },
}
